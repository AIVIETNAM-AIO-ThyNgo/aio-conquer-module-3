# Virtual environment (uv / venv)
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
build/
dist/

# uv / pip lock/cache artifacts
uv.lock
.python-version

# Jupyter
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp

# Agentic
.codegraph/

# Generated pipeline outputs (CSVs, JSONs) -- never commit test/run artifacts
# Only test *scripts* under tests/ are tracked; their outputs are not.
**/output/*.csv
**/output/*.json
data/processed/*.csv
data/processed/*.json
data/raw/*.csv
data/raw/*.json
docs/*.csv
results/*.csv
results/*.json
pipeline_manifest.json

